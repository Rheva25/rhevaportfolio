rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if the user has the admin custom claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /media/{allPaths=**} {
      allow read: if true; // Media library is readable by anyone
      allow write: if isAdmin(); // Only admin can upload/update/delete media
    }

    match /public/{allPaths=**} {
      allow read: if true; // Public media is readable by anyone
      allow write: if isAdmin(); // Only admin can upload to public
    }

    match /private/{allPaths=**} {
      // Inquiries might be uploaded anonymously but read should be admin only
      allow create: if true; // Public users can submit attachments
      allow read, update, delete: if isAdmin();
    }
  }
}
