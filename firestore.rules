rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user has the admin custom claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Projects
    match /projects/{document=**} {
      allow read: if resource.data.visibility == 'Published' || isAdmin();
      allow write: if isAdmin();
    }

    // Products / Apps
    match /products/{document=**} {
      allow read: if resource.data.visibility == 'Published' || isAdmin();
      allow write: if isAdmin();
    }

    // Articles
    match /articles/{document=**} {
      allow read: if resource.data.status == 'Published' || isAdmin();
      allow write: if isAdmin();
    }

    // Inquiries
    match /inquiries/{document=**} {
      // Public users can submit inquiries (create only)
      allow create: if true; 
      // Only admin can view/update/delete inquiries
      allow read, update, delete: if isAdmin(); 
    }

    // Media
    match /media/{document=**} {
      // Assuming media records are public metadata for public files.
      // If we only want published media, we'd check usage, but the prompt says:
      // "MEDIA: only isAdmin() may modify media metadata."
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
